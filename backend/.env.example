# Secrets & environment — copy to backend/.env and edit
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave POSTGRES_* unset to use local SQLite for development
# POSTGRES_DB=smartdesk
# POSTGRES_USER=smartdesk
# POSTGRES_PASSWORD=smartdesk
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ML_ARTIFACTS_DIR=
ML_AUTO_TRIAGE=true
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
LOG_LEVEL=INFO
